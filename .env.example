# ---- Required ----
# Postgres connection string. Render provides this automatically when the
# database is linked (see render.yaml). For local dev, point it at any
# Postgres instance you control.
DATABASE_URL=postgres://user:password@localhost:5432/rise

# Random string used to sign session cookies. Use a long random value.
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of the deployed app (no trailing slash). Used to build
# Stripe Checkout / Billing Portal return URLs.
APP_BASE_URL=https://riseonemanshow.com

# ---- Stripe (live billing) ----
# If ANY of these are missing, the app runs in TEST MODE: billing is
# simulated in-app (clearly labeled) and no real charges are possible.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Price ID of the $10.99/month recurring price (created in the Stripe
# Dashboard under the product, see README step 5).
STRIPE_PRICE_ID=price_...
# Signing secret of the webhook endpoint (README step 6).
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Optional ----
# Platform admin login (the product owner's cross-company view).
# Defaults are development-only values; ALWAYS set these in production.
PLATFORM_ADMIN_EMAIL=platform@rise.local
PLATFORM_ADMIN_PASSWORD=platform123

# Set to "true" to seed the demo company (Demo Doors LLC,
# demo@demo.com / demo1234) on first boot. Leave unset/false in production
# unless you deliberately want a public demo tenant.
SEED_DEMO=false

PORT=3000
